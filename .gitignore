# Byte-compiled / Python cache files (catches cache in ALL subdirectories)
__pycache__/
*.py[cod]
*$py.class

# Environment and IDE config
.DS_Store
.idea/
.vscode/

# Virtual Environments
venv/
.venv/
env/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore Excel files generated or used during processing
*.xlsx
*.xls

# Data directory strategy:
# Option A (Current): If data is hosted elsewhere and shouldn't be in Git at all, keep data/ ignored:
data/

# Option B (Recommended): Ignore large raw data files, but allow tracking folder structure or sample files
# data/raw/*
# !data/raw/.gitkeep